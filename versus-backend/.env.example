# ─────────────────────────────────────────────
# VERSUS — Fichier d'environnement (copie en .env)
# ─────────────────────────────────────────────

# Serveur
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=change_moi_en_production_avec_une_chaine_longue_et_aleatoire
JWT_EXPIRES_IN=30d

# Base de données SQLite (chemin relatif)
DB_PATH=./versus.db

# Upload de preuves (taille max en Mo)
MAX_UPLOAD_MB=10
UPLOAD_DIR=./uploads

# CORS — URL du front (React/Vite)
CORS_ORIGIN=http://localhost:5173

# ELO — gains/pertes par défaut
ELO_WIN=18
ELO_LOSS=15
ELO_MIN=1000

# SuperAdmin (créé au premier démarrage si pas en DB)
SUPERADMIN_NAME=Alex
SUPERADMIN_TAG=@alex_god
SUPERADMIN_PASSWORD=versus123
